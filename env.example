# --- لازم ---
BOT_TOKEN=

# --- عضویت اجباری و آمار گروه ---
FORCE_JOIN_ENABLED=1
# enforce = اجبار بعد از دوره‌ی گرم‌کردن | log = فقط ثبت در جدول (بدون حذف و هشدار)
FORCE_JOIN_MODE=enforce
FORCE_JOIN_WARMUP=0
# اعتبار تأیید عضویت (ثانیه)؛ بعد از این مدت برای هر نفر یک بار دوباره از تلگرام پرسیده می‌شود
MEMBER_CACHE_TTL=21600
MEMBERS_TABLE=channel_members
FORCE_JOIN_CHANNEL=@SuperExNews_Iran
GROUP_IDS=
GROUP_STATS_DB=group_stats.sqlite3
STATS_AUTO_TIME=

# --- مانیتور لیست جدید (خالی = خاموش) ---
LISTING_CHAT_ID=
LISTING_CHECK_INTERVAL=600
# بخش‌های فعال (خالی = هر چهار بخش): listings,announcements,events,updates
LISTING_SECTIONS=
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_TABLE=seen_listings

# ایموجی پریمیوم (0 = خاموش و همه‌جا ایموجی معمولی)
PREMIUM_EMOJI=1
